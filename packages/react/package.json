{
  "name": "@captra/react",
  "version": "0.2.0",
  "description": "React hooks and safe capability views for Captra.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaibhavBansal26/captra.git",
    "directory": "packages/react"
  },
