{
  "name": "captra",
  "version": "0.10.0",
  "description": "The AI-native JavaScript framework for typed capabilities, agents, memory, tools, and generated UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaibhavBansal26/captra.git",
    "directory": "packages/captra"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server/node": {
      "types": "./dist/server-node.d.ts",
      "import": "./dist/server-node.js"
    },
    "./server/express": {
      "types": "./dist/server-express.d.ts",
      "import": "./dist/server-express.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@captra-ai/client": "^0.3.1",
    "@captra-ai/core": "^0.8.0",
    "@captra-ai/openai": "^0.5.0",
    "@captra-ai/postgres": "^0.5.1",
    "@captra-ai/react": "^0.4.1",
    "@captra-ai/server": "^0.7.0",
    "@captra-ai/state": "^0.4.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
