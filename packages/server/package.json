{
  "name": "@captra-ai/server",
  "version": "0.5.0",
  "description": "Framework-neutral HTTP handler for Captra applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaibhavBansal26/captra.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@captra-ai/core": ">=0.4.0 <1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.0.4",
    "zod": "^4.1.12"
  }
}
