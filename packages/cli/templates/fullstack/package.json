{
  "name": "{{projectName}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server.ts\"",
    "build": "captra secrets && tsc -p tsconfig.app.json --noEmit && vite build && captra secrets --dist && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "test": "vitest run",
    "eval": "captra eval"
  },
  "dependencies": {
    "captra": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@captra-ai/cli": "^0.7.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
